# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Names only here: do not put real values in this file.
# None of these use the NEXT_PUBLIC_ prefix on purpose, so they are never
# exposed to the browser. All Supabase access happens in server code.
#
# For everyday local development, use the local Supabase stack's values from
# `npx supabase status`, never production's. Production values (the Supabase
# dashboard locations below) are for Vercel, and for temporarily running an
# admin script against production.

# Supabase project URL.
# Source: local, `npx supabase status` (API URL); production, Supabase
# dashboard > Project Settings > API (Project URL).
# Used by: the server-side Supabase client and proxy (local and Vercel).
SUPABASE_URL=

# Supabase publishable key (looks like sb_publishable_...). Low privilege;
# row-level security still applies.
# Source: local, `npx supabase status` (Publishable key); production,
# Supabase dashboard > Project Settings > API Keys.
# Used by: the server-side Supabase client and proxy (local and Vercel).
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (looks like sb_secret_...). SECRET: bypasses row-level
# security.
# Source: local, `npx supabase status` (Secret key); production, Supabase
# dashboard > Project Settings > API Keys.
# Used by: local admin scripts only (team and participant seeding).
# Do NOT set this in Vercel.
SUPABASE_SECRET_KEY=
